{
  "dataDir": "~/.mimin/data",
  "context": {
    "maxTokens": 32000,
    "reserveTokens": 8000
  },
  "review": {
    "maxReviewIterations": 2
  },
  "security": {
    "injectionWarning": true
  },
  "manager": {
    "provider": "anthropic",
    "model": "claude-sonnet-4-6",
    "thinking": "medium"
  },
  "sidekick": {
    "model": "claude-sonnet-4-6",
    "thinking": "low"
  }
}
